# ─── Meta App credentials (required) ───────────────────────────────
# Create a Meta App at https://developers.facebook.com/apps, add the
# "Facebook Login for Business" and "Marketing API" products, then paste
# the App ID + Secret here.
META_APP_ID=
META_APP_SECRET=

# The OAuth callback URL must EXACTLY match what you registered in the
# Meta App's "Facebook Login for Business → Valid OAuth Redirect URIs".
OAUTH_REDIRECT_URI=http://localhost:8765/api/auth/callback

# Where the web app is served. The OAuth callback bounces the user back
# to <WEB_ORIGIN>/brands after a successful connect.
WEB_ORIGIN=http://localhost:5173

# ─── Encryption ────────────────────────────────────────────────────
# Random key used to encrypt access tokens at rest. Generate once:
#   openssl rand -hex 32
# IMPORTANT: don't change this after the first connect — existing tokens
# become unreadable. If you do change it, run "Disconnect Meta" then
# "Connect Meta" again from the web UI.
LENS_SECRET_KEY=

# ─── Optional ──────────────────────────────────────────────────────
# Set to 1 when serving over HTTPS so the session cookie gets the
# Secure flag. Leave 0 for local development.
LENS_COOKIE_SECURE=0

# Custom Meta API version (default v23.0). Bump when Meta releases a new
# stable version that adds fields you need.
# META_API_VERSION=v23.0

# Override SQLite path. Default: ~/.odylic-lens/lens.db
# LENS_DB_PATH=/var/lib/odylic-lens/lens.db

# OAuth scopes. Default is enough for read-only Creative Analysis.
# META_OAUTH_SCOPES=ads_read,ads_management,business_management
